[Unit]
Description=Zigbee2MQTT (Zigbee button for Wortkarten)
After=network.target mosquitto.service
Wants=mosquitto.service

[Service]
User=keivan
WorkingDirectory=/opt/zigbee2mqtt
ExecStart=/usr/bin/node index.js
Environment=NODE_ENV=production
# zigbee2mqtt writes its own log files to /opt/zigbee2mqtt/data/log/
StandardOutput=null
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
